        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a408" ANNOTATION_REF="a405">
                <ANNOTATION_VALUE>говорящий качается телом в ритм</ANNOTATION_VALUE>
            </REF_ANNOTATION>
